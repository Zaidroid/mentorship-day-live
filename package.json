{
  "name": "mentorship-day-live",
  "private": true,
  "type": "module",
  "description": "Mentorship Day 2026 live big screen, phone page and operator remote",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "REMOTE_PIN=${REMOTE_PIN:-123456} DATA_DIR=dev/blobs PORT=${PORT:-8897} node server/index.mjs",
    "start": "LOCAL_CDN=${LOCAL_CDN:-1} node server/index.mjs",
    "seed": "bash scripts/seed.sh http://localhost:8897",
    "test": "node scripts/e2e.cjs",
    "test:api": "node --test --test-reporter=spec scripts/api-test.mjs",
    "test:phone": "node scripts/e2e-phone.cjs",
    "test:remote": "node scripts/e2e-remote.cjs",
    "deploy": "netlify deploy --prod",
    "baseline": "node scripts/baseline.cjs",
    "probe": "node scripts/probe.cjs",
    "sim": "node scripts/sim.mjs",
    "load": "node scripts/sim.mjs --load"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.9"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
